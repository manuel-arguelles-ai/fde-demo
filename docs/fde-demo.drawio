<mxfile host="app.diagrams.net"><diagram name="fde-demo - Componentes" id="fde-demo-v1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="fde-demo — Build del track DataCamp “Forward Deployed Engineer” · en producción (https://fde.analizodatos.com · VPS Hetzner, Alemania)" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Segoe UI;align=left;fontColor=#1b2733;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="z1" value="Personas" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=none;strokeColor=#c0504d;fontColor=#c0504d;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="190" height="540" as="geometry"/></mxCell><mxCell id="z2" value="VPS Hetzner CX33 · Nuremberg, UE — todo el razonamiento ocurre aquí" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#f8fcfa;strokeColor=#2e8b57;fontColor=#2e8b57;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="70" width="1010" height="540" as="geometry"/></mxCell><mxCell id="zA" value="🔒 Entrada · proxy TLS (Traefik) + Cloudflare DNS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#ffffff;strokeColor=#e0a254;fontColor=#e0a254;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="245" y="110" width="185" height="470" as="geometry"/></mxCell><mxCell id="zB" value="App fde-demo (FastAPI · LangGraph)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#ffffff;strokeColor=#2e8b57;fontColor=#2e8b57;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="110" width="780" height="300" as="geometry"/></mxCell><mxCell id="zD" value="Datos" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#ffffff;strokeColor=#2f6fb5;fontColor=#2f6fb5;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="445" y="425" width="780" height="155" as="geometry"/></mxCell><mxCell id="z3" value="Servicios externos" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=none;strokeColor=#e5675a;fontColor=#e5675a;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1265" y="70" width="260" height="250" as="geometry"/></mxCell><mxCell id="usuario" value="👤 Usuario&#xa;(navegador)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fdeee9;strokeColor=#c0504d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="150" height="62" as="geometry"/></mxCell><mxCell id="admin" value="👨 Manuel&#xa;(dueño de la demo)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fdeee9;strokeColor=#c0504d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="150" height="62" as="geometry"/></mxCell><mxCell id="dns" value="🌐 Cloudflare DNS&#xa;A → 167.233.82.133" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fff4e0;strokeColor=#e0a254;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="150" width="160" height="70" as="geometry"/></mxCell><mxCell id="traefik" value="🔒 Traefik&#xa;TLS + Let&#x27;s Encrypt&#xa;(termina HTTPS)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fff4e0;strokeColor=#e0a254;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="160" height="80" as="geometry"/></mxCell><mxCell id="landing" value="🖥 Landing con chat&#xa;(static/index.html)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fff4e0;strokeColor=#e0a254;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="465" y="150" width="140" height="70" as="geometry"/></mxCell><mxCell id="chatapi" value="⚙ POST /chat y&#xa;/chat/stream (SSE)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#2e8b57;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="140" height="62" as="geometry"/></mxCell><mxCell id="middleware" value="🛡 Middleware&#xa;auth X-API-Key + log" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fff7d6;strokeColor=#c99a00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="775" y="150" width="140" height="62" as="geometry"/></mxCell><mxCell id="retrieve" value="📄 Retriever BM25&#xa;(k=3 chunks)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#2e8b57;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="935" y="150" width="140" height="62" as="geometry"/></mxCell><mxCell id="gate" value="🚧 Gate LLM&#xa;¿el contexto alcanza?" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fff7d6;strokeColor=#c99a00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="150" width="140" height="62" as="geometry"/></mxCell><mxCell id="bump" value="🔁 Reformular&#xa;(feedback loop ×1)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#2e8b57;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="935" y="270" width="140" height="62" as="geometry"/></mxCell><mxCell id="generate" value="💬 Generador&#xa;con citas [Sección]" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#2e8b57;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="775" y="270" width="140" height="62" as="geometry"/></mxCell><mxCell id="escalate" value="✋ Escalado&#xa;→ tool create_ticket" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#2e8b57;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="270" width="140" height="80" as="geometry"/></mxCell><mxCell id="stream" value="📡 Respuesta en vivo&#xa;SSE token a token" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fff4e0;strokeColor=#e0a254;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="465" y="270" width="140" height="70" as="geometry"/></mxCell><mxCell id="kb" value="📚 Corpus de conocimiento&#xa;docs/kb.md (6 secciones)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#e8f1fb;strokeColor=#2f6fb5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="465" y="465" width="190" height="85" as="geometry"/></mxCell><mxCell id="tickets" value="🎟 tickets.jsonl&#xa;(escalados con tool call)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#e8f1fb;strokeColor=#2f6fb5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="890" y="465" width="170" height="85" as="geometry"/></mxCell><mxCell id="logs" value="📝 logs/app.jsonl&#xa;(requests, tickets, latencia)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#e8f1fb;strokeColor=#2f6fb5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="675" y="475" width="180" height="65" as="geometry"/></mxCell><mxCell id="groq" value="🤖 Groq · gpt-oss-120b&#
ge="1" parent="1" source="gate" target="generate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="2º fallo → escalar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="generate" target="escalate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="generate" target="stream"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="respuesta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="stream" target="usuario"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="BM25 k=3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="retrieve" target="kb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="function calling" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="escalate" target="tickets"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="middleware" target="logs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="gate · generación · tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="chatapi" target="groq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="HTTP-01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="traefik" target="lets"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="commit/deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="admin" target="github"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="docker deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="github" target="z2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="1" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="28" y="128" width="26" height="26" as="geometry"/></mxCell><mxCell id="c23" value="2" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="248" y="288" width="26" height="26" as="geometry"/></mxCell><mxCell id="c24" value="3" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="453" y="138" width="26" height="26" as="geometry"/></mxCell><mxCell id="c25" value="4" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="608" y="138" width="26" height="26" as="geometry"/></mxCell><mxCell id="c26" value="5" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="763" y="138" width="26" height="26" as="geometry"/></mxCell><mxCell id="c27" value="6" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="923" y="138" width="26" height="26" as="geometry"/></mxCell><mxCell id="c28" value="7" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1098" y="138" width="26" height="26" as="geometry"/></mxCell><mxCell id="c29" value="8" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="763" y="258" width="26" height="26" as="geometry"/></mxCell><mxCell id="c30" value="9" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="453" y="258" width="26" height="26" as="geometry"/></mxCell><mxCell id="c31" value="10" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="878" y="453" width="26" height="26" as="geometry"/></mxCell><mxCell id="c32" value="11" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="663" y="463" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Qué ocurre en cada paso&lt;/b&gt;&lt;br&gt;1  El usuario abre https://fde.analizodatos.com: Cloudflare resuelve el dominio al VPS (A record, sin proxy de CF).&lt;br&gt;2  Traefik termina el TLS (cert de Let&amp;#x27;s Encrypt, renovación automática) y enruta por Host al container fde-demo de la red dokploy-network.&lt;br&gt;3  La landing (HTML estático) carga y corre el chat en el navegador; no guarda estado del servidor.&lt;br&gt;4  Cada pregunta va a POST /chat o /chat/stream: FastAPI con Pydantic de schema y respuesta SSE (token a token).&lt;br&gt;5  El middleware verifica la API key si FDE_API_KEY está seteada (401 si falta) y registra el evento en logs JSONL (path, status, ms).&lt;br&gt;6  El retriever BM25 (lexical, 2 etapas, k=3) busca sobre los 6 chunks de docs/kb.md. Decisión documentada: sin embeddings para no sumar un proveedor; el swap a un vector store es drop-in.&lt;br&gt;7  El gate (LLM, temperatura 0) pregunta si el contexto alcanzó para responder. Arista condicional de LangGraph: SÍ → generar; NO con 1er intento → reformular y volver a recuperar (feedback loop); NO con 2do → escalar.&lt;br&gt;8  El generador responde en español con citas [Sección] y el grafo queda trazado (cada nodo es un paso verificable).&lt;br&gt;9  La respuesta sale por SSE token a token y la landing la muestra en vivo con las fuentes usadas.&lt;br&gt;10 Si el gate falla dos veces, el escalado usa function calling real: el LLM decide los argumentos del tool create_ticket y el ticket queda persistido en tickets.jsonl (ESC-XXXXXXXX).&lt;br&gt;11 Toda operación queda en logs/app.jsonl (requests, latencias, tickets) — la capa LLMOps del curso 8/16: eval offline con eval_set.json (correctness 9/9, groundedness 6/6)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#c3cad3;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1180" height="240" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Naranja: entrada · Verde: servicio · Amarillo: guardrail · Azul: datos · Rosa: persona · Rojo: externo. Línea discontinua: relación secundaria o flujo de retorno (feedback loop / escalado)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#c3cad3;spacing=8;" vertex="1" parent="1"><mxGeometry x="1215" y="630" width="310" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>